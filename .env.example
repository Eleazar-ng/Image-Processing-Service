# Application
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=debug
# Set to false in production to hide the Swagger UI and OpenAPI document
SWAGGER_ENABLED=true

# Database (must match the POSTGRES_* values below)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/image_service?schema=public

# Local services (Docker Compose). Defaults are for local development only.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=image_service
POSTGRES_PORT=5432
REDIS_PORT=6379
