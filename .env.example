# Application
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=debug
# Set to false in production to hide the Swagger UI and OpenAPI document
SWAGGER_ENABLED=true

# Database (must match the POSTGRES_* values below)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/image_service?schema=public

# Authentication
# Generate a secret with: openssl rand -base64 48 (at least 32 characters)
JWT_ACCESS_SECRET=dev-only-secret-change-me-at-least-32-characters
# Access token lifetime: 15 minutes. Refresh token lifetime: 7 days.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# Admin seed (read only by `pnpm db:seed`; leave commented out otherwise)
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=choose-a-strong-password-of-12-or-more-characters

# Local services (Docker Compose). Defaults are for local development only.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=image_service
POSTGRES_PORT=5432
REDIS_PORT=6379
